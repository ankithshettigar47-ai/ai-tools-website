{
  "permissions": {
    "allow": [
      "Bash(dir *)",
      "Bash(del *)",
      "Bash(true)",
      "Bash(rmdir *)",
      "Bash(cargo install *)",
      "Bash(cargo new *)",
      "Bash(cargo add *)",
      "Bash(npm create *)",
      "Bash(mkdir *)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(rustup *)",
      "Bash(cargo clean)"
    ]
  },
  "$version": 4
}